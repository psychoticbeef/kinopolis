#!/usr/bin/env bash
set -euo pipefail
: "${PUSHOVER_TOKEN:?PUSHOVER_TOKEN fehlt}"
: "${PUSHOVER_USER:?PUSHOVER_USER fehlt}"
message=$(cat)
response=$(curl --fail --silent --show-error --connect-timeout 10 --max-time 30 \
    --form-string "token=$PUSHOVER_TOKEN" \
    --form-string "user=$PUSHOVER_USER" \
    --form-string "title=Kinoticket: $KINO_WATCH_ID" \
    --form-string "message=$message" \
    https://api.pushover.net/1/messages.json)
# Pushover also communicates application errors in JSON.
[[ $response =~ \"status\"[[:space:]]*:[[:space:]]*1([,}]|[[:space:]]) ]]
